        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dpn" />
            <size android:height="@dimen/dpn" android:width="@dimen/dpn" />
            <stroke android:width="@dimen/dpd" android:color="@color/recom_top_tip_bg_color_cv" />
